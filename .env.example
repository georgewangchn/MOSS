# LLM API
LLM_API_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-v4-pro

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# 组织原型（org 词汇表的行业上下文，可选）
# 可选值见 `moss org list`：pharma(化学制药) / hospital(三级医院) / battery(动力电池) / internet-med(互联网医疗)
# 声明后行业特化定义类生效；不声明 = 通用治理模式（行业类静默，岗位对齐仍可用通用层）
# MOSS_ARCHETYPE=pharma
